# Run scripts/bootstrap_env.py to generate local secrets; never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cctv_search_test
DB_USER=change_me
DB_PASSWORD=change_me
SESSION_SECRET=generate_a_random_secret_of_at_least_32_characters
RTSP_ENCRYPTION_KEY=generate_with_cryptography_fernet
SERVICE_TOKEN=generate_a_random_secret_of_at_least_32_characters
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
ALLOWED_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:8000","http://127.0.0.1:8000"]
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_VERSION=1.19.1
REQUESTED_DEVICE=cuda
ALLOW_CPU_FALLBACK=false
WORKER_URL=http://127.0.0.1:8001
YOLO_MODEL_PATH=data/models/yolo11n.pt
VIDEO_DIR=data/videos
DETECTION_FPS=5
DETECTION_CONFIDENCE=0.1
TRACK_LOW_THRESHOLD=0.1
TRACK_HIGH_THRESHOLD=0.5
NEW_TRACK_THRESHOLD=0.6
TRACK_LOST_SECONDS=3
MAX_ACTIVE_CAMERAS=4
RTSP_OPEN_TIMEOUT_SECONDS=5
RTSP_READ_TIMEOUT_SECONDS=3
RTSP_RECONNECT_INITIAL_SECONDS=1
RTSP_RECONNECT_MAX_SECONDS=30
RTSP_RECONNECT_JITTER=0.2
RTSP_RECONNECT_RESET_SECONDS=10
PREVIEW_FPS=5
PREVIEW_VIEWERS_PER_CAMERA=4
PREVIEW_VIEWERS_TOTAL=16
VIDEO_UPLOAD_MAX_MB=200
VIDEO_STORAGE_MAX_MB=1000
GPU_REPORT_PATH=data/reports/gpu.json
LOG_DIR=logs
FACE_MODEL_DIR=data/models/buffalo_l
FACE_ANALYSIS_INTERVAL=0.5
FACE_ROIS_PER_FRAME=4
FACE_TRACKS_PER_CAMERA=100
FACE_SAMPLE_COUNT=5
FACE_SAMPLE_WINDOW_SECONDS=3
FACE_TRACK_CONSISTENCY_THRESHOLD=0.3
RECOGNITION_LOG_RETENTION_DAYS=7
RECOGNITION_LOG_MAX_RECORDS=100000
RECOGNITION_LOG_QUEUE_SIZE=256
FACE_MIN_SIZE=80
FACE_DETECTION_THRESHOLD=0.5
FACE_QUALITY_THRESHOLD=0.7
FACE_MIN_BLUR=60
FACE_MAX_YAW=40
FACE_MAX_PITCH=30
FACE_MAX_ROLL=35
REFERENCE_DIR=data/references
REFERENCE_UPLOAD_MAX_MB=10
REFERENCE_STORAGE_MAX_MB=200
REFERENCE_IMAGE_RETENTION_DAYS=30
REFERENCE_EMBEDDING_RETENTION_DAYS=30
REFERENCE_CLEANUP_INTERVAL_SECONDS=30
MAX_TARGET_PERSONS=100
REFERENCE_FACES_PER_PERSON=20
FACE_SEARCH_PROVIDER=auto
FACE_MEMORY_MAX_REFERENCES=200
# Initial comparison criterion; saved Function Settings values take precedence.
FACE_MATCH_THRESHOLD=0.75
FACE_COLLECTION=face_embeddings

# Phase 6: internal API URL, bounded queues and independent event/image retention.
API_URL=http://127.0.0.1:8000
EVENT_DIR=data/events
EVENT_COOLDOWN=30
EVENT_RETENTION_DAYS=30
EVENT_IMAGE_RETENTION_DAYS=7
EVENT_STORAGE_MAX_MB=500
EVENT_MAX_RECORDS=50000
EVENT_QUEUE_SIZE=32
EVENT_CLEANUP_INTERVAL_SECONDS=30
EVENT_WS_QUEUE_SIZE=64
EVENT_WS_MAX_CLIENTS=32
EVENT_WS_SEND_TIMEOUT_SECONDS=5

# Phase 8: private video-only event clips, bounded compressed disk buffer
CLIP_ENABLED=true
VIDEO_BUFFER_BEFORE=5
VIDEO_BUFFER_AFTER=10
VIDEO_BUFFER_MAX_BYTES_PER_CAMERA=33554432
STORAGE_MAX_BYTES=1073741824
STORAGE_MIN_FREE_BYTES=104857600
CLIP_FPS=10
CLIP_WIDTH=1280
CLIP_RETENTION_DAYS=7
CLIP_MAX_PENDING=32

# Phase 9: bounded shared CUDA detector batches, face models keep their precision
DETECTOR_BATCH_SIZE=4
YOLO_FP16=false
DETECTOR_BATCH_FACE_BUDGET_MS=100
CAPTURE_DECODE_THREADS=2
OPENCV_THREADS=2
